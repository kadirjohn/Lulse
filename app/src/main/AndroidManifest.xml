<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lulse IMU sensörleri kullanır. required=false: sensörsüz cihazlarda
         yükleme engellenmesin, runtime'da zarif fallback (SensorRepository kontrol eder). -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <!-- FASTEST sampling rate (0µs) için gerekli normal izin — Android 14+ (API 34+)
         bu izin declared değilse registerListener anında SecurityException atar.
         Kullanıcı onayı gerektirmez, sadece manifest'te declared olması yeterli. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lulse">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Lulse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wear OS Data Layer listener — watch'tan gelen mesajları alır (watch6 integration).
             WearableListenerService manifest-declared; BIND_LISTENER deprecated, intent-filter gerekmez. -->
        <service
            android:name=".data.wear.WearMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>
    </application>

</manifest>